{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/{*.py,app/**}",
      "excludeFiles": "backend/{tests/**,.venv/**,data/**,**/__pycache__/**,app/ml/test_*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/site.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/site.html",
      "permanent": false
    }
  ]
}
